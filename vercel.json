{
  "functions": {
    "api/main.py": {
      "excludeFiles": "{conta_libras_2,dashboard,Feedback,.planning}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/main"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/conta_libras_2/build/web/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/conta_libras_2/build/web/$1"
    }
  ]
}
